<UserControl x:Class="Qenex.QInsight.Views.SolutionExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Qenex.QInsight.Views"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:conv="clr-namespace:Qenex.QInsight.Converters"
             xmlns:wrappers="clr-namespace:Qenex.QInsight.ViewModels.SolutionExplorerWrappers"
             xmlns:dragdrop="clr-namespace:Qenex.QInsight.DragDrop"
             xmlns:viewableItem="clr-namespace:Qenex.QInsight.ViewModels.ViewableItem"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SolutionExplorerViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources> 
        <Style x:Key="RadTreeViewItemStyle" TargetType="telerik:RadTreeViewItem" BasedOn="{StaticResource RadTreeViewItemStyle}">
            <Setter Property="ExpanderButtonMinWidth" Value="18"/> 
            <Setter Property="telerik:DragDropManager.AllowDrag" Value="True"></Setter>
            <Setter Property="telerik:DragDropManager.AllowCapturedDrag" Value="True"></Setter>
        </Style>         
        
        <conv:TypeNameToVisibilityConverter x:Key="ContextMenuVisibilityConverter"/>
    </UserControl.Resources> 
    
    <Grid>
        <telerik:RadTreeView
            x:Name="SolutionTreeView"
            ItemsSource="{Binding ProjectModules}"
            IsVirtualizing="True"
            PathSeparator="/"
            IsLineEnabled="True"
            ItemsIndent="20"
            IsRootLinesEnabled="False" 
            HorizontalAlignment="Left"
            ItemContainerStyle="{StaticResource RadTreeViewItemStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="ItemDoubleClick">
                    <i:InvokeCommandAction Command="{Binding TreeViewDoubleCLickCommand}" PassEventArgsToCommand="True"
                                           CommandParameter="{Binding ElementName=SolutionTreeView, Path=SelectedItem}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            
            <telerik:RadTreeView.ItemTemplate> 
                <HierarchicalDataTemplate DataType="{x:Type viewableItem:IViewableItem}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="-10,-4,0,-4"
                                Tag="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadTreeView}, Path=DataContext}">
                        <Image Source="{Binding Icon}"
                               RenderOptions.BitmapScalingMode="Fant"
                               Stretch="Fill" Width="24" Height="24"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" FontWeight="{Binding LabelWeight}"/>
                        <StackPanel.ToolTip>
                            <ToolTip Visibility="{Binding ToolTipVisibility}">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding ToolTip}"/>
                                </StackPanel>
                            </ToolTip>
                        </StackPanel.ToolTip>
                        <telerik:RadContextMenu.ContextMenu>
                            <telerik:RadContextMenu InheritDataContext="False"
                                                    Visibility="{Binding Converter={StaticResource ContextMenuVisibilityConverter},
                                                   ConverterParameter='WorkspaceWrapper'}">
                                <telerik:RadMenuItem
                                    Header="Remove"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadContextMenu}, Path=UIElement.Tag.RemoveViewableItemCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadContextMenu}, Path=UIElement.DataContext}" />                             
                            </telerik:RadContextMenu>
                        </telerik:RadContextMenu.ContextMenu>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </telerik:RadTreeView.ItemTemplate>
            
            <i:Interaction.Behaviors>
                <dragdrop:VariableDragAndDropBehavior/>
            </i:Interaction.Behaviors>
            
        </telerik:RadTreeView>
    </Grid>
</UserControl>