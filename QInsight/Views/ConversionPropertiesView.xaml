<UserControl x:Class="Qenex.QInsight.Views.ConversionPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:wrappers="clr-namespace:Qenex.QInsight.ViewModels.ModelWrappers"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:ConversionPropertiesViewModel, IsDesignTimeCreatable=False}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <ItemsControl ItemsSource="{Binding Properties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type wrappers:EditablePropertyWrapper}">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <q:QTextBlock Grid.Column="0"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Text="{Binding Name}" />

                            <Grid Grid.Column="1">
                                <q:QTextBlock x:Name="ValueTextBlock"
                                              Visibility="Collapsed"
                                              VerticalAlignment="Center"
                                              Text="{Binding ValueText}"
                                              ToolTip="{Binding Error}" />
                                <q:QTextBox x:Name="ValueTextBox"
                                            Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            ToolTip="{Binding Error}" />
                                <telerik:RadComboBox x:Name="ValueComboBox"
                                                     Visibility="Collapsed"
                                                     ItemsSource="{Binding Options}"
                                                     IsEnabled="{Binding IsEditable}"
                                                     SelectedItem="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding Error}" />
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                <Setter TargetName="ValueTextBox" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ValueComboBox" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                <Setter TargetName="ValueTextBlock" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ValueTextBox" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ValueTextBox" Property="Focusable" Value="False" />
                                <Setter TargetName="ValueTextBox" Property="IsEnabled" Value="False" />
                                <Setter TargetName="ValueComboBox" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ValueComboBox" Property="Focusable" Value="False" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="EnumValuesPanel"
                        Margin="0,6,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnumConversion}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Grid Margin="90,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <q:QTextBlock Grid.Column="0"
                                  Margin="0,0,10,0"
                                  FontWeight="SemiBold"
                                  Text="Name" />
                    <q:QTextBlock Grid.Column="1"
                                  FontWeight="SemiBold"
                                  Text="Value" />
                </Grid>

                <ItemsControl ItemsSource="{Binding EnumValues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EnumConversionValueWrapper}">
                            <Grid Margin="90,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <q:QTextBox Grid.Column="0"
                                            Margin="0,0,10,0"
                                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            ToolTip="{Binding Error}" />
                                <q:QTextBox Grid.Column="1"
                                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            IsReadOnly="{Binding IsReadOnly}"
                                            ToolTip="{Binding Error}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
