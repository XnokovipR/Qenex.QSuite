<UserControl x:Class="Qenex.QInsight.Views.ProjectConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:wrappers="clr-namespace:Qenex.QInsight.ViewModels.ModelWrappers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProjectConfigurationViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="520"
             d:DesignWidth="860">
    <UserControl.Resources>
        <Style x:Key="ProjectConfigurationPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="{x:Type q:QTextBox}" BasedOn="{StaticResource {x:Type TextBox}}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <telerik:RadListBox
                Margin="8"
                ItemsSource="{Binding NavigationItems}"
                SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                <telerik:RadListBox.ItemTemplate>
                    <DataTemplate>
                        <q:QTextBlock
                            Margin="8,6"
                            VerticalAlignment="Center"
                            Text="{Binding Label}"/>
                    </DataTemplate>
                </telerik:RadListBox.ItemTemplate>
            </telerik:RadListBox>
        </Border>

        <Grid Grid.Row="0"
              Grid.Column="1">
            <Grid
                Margin="8">
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ProjectConfigurationPageStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:ProjectConfigurationSection.CommunicationDrivers}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <telerik:RadGridView
                    ItemsSource="{Binding Drivers}"
                    AutoGenerateColumns="False"
                    CanUserDeleteRows="False"
                    CanUserInsertRows="False"
                    GroupRenderMode="Flat"
                    RowIndicatorVisibility="Collapsed"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn
                            Width="70"
                            Header="Enabled"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanEditIsEnabled}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="*"
                            Header="Label"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Label}"
                                        ToolTip="{Binding ToolTip}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Grid>

            <Grid Margin="8">
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ProjectConfigurationPageStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:ProjectConfigurationSection.Variables}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Column="0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <q:QTextBlock
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="Variables"/>
                    <Border
                        Grid.Row="1"
                        Height="{Binding ActualHeight, ElementName=SourceProtocolCombo}"
                        Margin="0,0,0,8"
                        Visibility="Hidden"/>
                    <telerik:RadListBox
                        Grid.Row="2"
                        ItemsSource="{Binding Variables}"
                        SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"/>

                    <q:QTextBlock
                        Grid.Row="3"
                        Margin="0,8,0,6"
                        FontWeight="SemiBold"
                        Text="Variable detail"/>
                    <ScrollViewer
                        Grid.Row="4"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedVariable.Properties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type wrappers:EditablePropertyWrapper}">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <q:QTextBlock
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"/>

                                        <Grid Grid.Column="1">
                                            <q:QTextBox
                                                x:Name="ValueTextBox"
                                                Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                ToolTip="{Binding Error}"/>
                                            <telerik:RadComboBox
                                                x:Name="ValueComboBox"
                                                Visibility="Collapsed"
                                                ItemsSource="{Binding Options}"
                                                SelectedItem="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{Binding Error}"/>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                            <Setter TargetName="ValueTextBox" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ValueComboBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="{Binding ActualHeight, ElementName=SourceProtocolLabel}"
                        Margin="0,0,0,6"
                        Visibility="Hidden"/>
                    <Border
                        Grid.Row="1"
                        Height="{Binding ActualHeight, ElementName=SourceProtocolCombo}"
                        Margin="0,0,0,8"
                        Visibility="Hidden"/>
                    <StackPanel
                        Grid.Row="2"
                        VerticalAlignment="Center">
                        <telerik:RadButton
                            Width="34"
                            Height="28"
                            Margin="0,0,0,6"
                            Command="{Binding AddVariableToSourceCommand}"
                            Content=">"/>
                        <telerik:RadButton
                            Width="34"
                            Height="28"
                            Command="{Binding RemoveCommunicatedVariableCommand}"
                            Content="&lt;"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <q:QTextBlock
                        x:Name="SourceProtocolLabel"
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="Source protocol"/>
                    <telerik:RadComboBox
                        x:Name="SourceProtocolCombo"
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        ItemsSource="{Binding SourceOptions}"
                        SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"/>

                    <telerik:RadListBox
                        Grid.Row="2"
                        ItemsSource="{Binding CommunicatedVariables}"
                        SelectedItem="{Binding SelectedCommunicatedVariable, Mode=TwoWay}">
                        <telerik:RadListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type wrappers:ProjectConfigurationProtocolVariableWrapper}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <q:QTextBlock
                                        Grid.Column="0"
                                        Text="{Binding DisplayName}"/>
                                    <q:QTextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Text="{Binding SourceText}"/>
                                </Grid>
                            </DataTemplate>
                        </telerik:RadListBox.ItemTemplate>
                    </telerik:RadListBox>

                    <q:QTextBlock
                        Grid.Row="3"
                        Margin="0,8,0,6"
                        FontWeight="SemiBold"
                        Text="Communication detail"/>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <q:QTextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Source"/>
                        <telerik:RadComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            ItemsSource="{Binding SelectedCommunicatedVariable.SourceOptions}"
                            SelectedItem="{Binding SelectedCommunicatedVariable.SelectedSource, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName"/>

                        <q:QTextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Event"/>
                        <telerik:RadComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            ItemsSource="{Binding SelectedCommunicatedVariable.VariableEventOptions}"
                            SelectedItem="{Binding SelectedCommunicatedVariable.SelectedVariableEventName, Mode=TwoWay}"/>

                        <q:QTextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Direction"/>
                        <telerik:RadComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            ItemsSource="{Binding SelectedCommunicatedVariable.DirectionOptions}"
                            SelectedItem="{Binding SelectedCommunicatedVariable.SelectedDirection, Mode=TwoWay}"/>

                        <q:QTextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Multiplier"/>
                        <q:QTextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            Text="{Binding SelectedCommunicatedVariable.Multiplier, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <q:QTextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Id"/>
                        <q:QTextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            Text="{Binding SelectedCommunicatedVariable.CommunicationId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <q:QTextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Comm params"/>
                        <q:QTextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            Text="{Binding SelectedCommunicatedVariable.CommParam, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <q:QTextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Script"/>
                        <telerik:RadComboBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            ItemsSource="{Binding SelectedCommunicatedVariable.ScriptOptions}"
                            SelectedItem="{Binding SelectedCommunicatedVariable.SelectedScriptFileName, Mode=TwoWay}"/>

                        <q:QTextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="0,0,10,6"
                            VerticalAlignment="Center"
                            Text="Script params"/>
                        <q:QTextBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            Text="{Binding SelectedCommunicatedVariable.ScriptAdditionalInfo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                        <CheckBox
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            Content="Communicated"
                            IsChecked="{Binding SelectedCommunicatedVariable.IsCommunicated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox
                            Grid.Row="9"
                            Grid.Column="1"
                            Margin="0,0,0,6"
                            Content="Log to FileDataLogger"
                            IsChecked="{Binding SelectedCommunicatedVariable.IsFileLogEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <q:QTextBlock
                            Grid.Row="10"
                            Grid.ColumnSpan="2"
                            Foreground="Tomato"
                            Text="{Binding ErrorMessage}">
                            <q:QTextBlock.Style>
                                <Style TargetType="{x:Type q:QTextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </q:QTextBlock.Style>
                        </q:QTextBlock>
                    </Grid>
                </Grid>
            </Grid>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ProjectConfigurationPageStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:ProjectConfigurationSection.Presentations}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ProjectConfigurationPageStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:ProjectConfigurationSection.Events}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <Grid
                Margin="8">
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ProjectConfigurationPageStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static vm:ProjectConfigurationSection.Scripts}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <telerik:RadButton
                        Width="34"
                        Height="28"
                        Margin="0,0,6,0"
                        Command="{Binding AddScriptCommand}"
                        Content="+"/>
                    <telerik:RadButton
                        Width="34"
                        Height="28"
                        Command="{Binding RemoveScriptCommand}"
                        Content="-"/>
                </StackPanel>

                <telerik:RadGridView
                    Grid.Row="1"
                    ItemsSource="{Binding Scripts}"
                    SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserDeleteRows="False"
                    CanUserInsertRows="False"
                    GroupRenderMode="Flat"
                    RowIndicatorVisibility="Collapsed"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn
                            Width="190"
                            Header="File name"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="34"
                            Header="Runtime"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="34"
                            Header="Replay"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsReplayEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="150"
                            Header="Execution mode"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadComboBox
                                        ItemsSource="{Binding DataContext.ExecutionModes, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        SelectedValuePath="Value"
                                        SelectedValue="{Binding ExecutionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="34"
                            Header="Blocking"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding Blocking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="75"
                            Header="Timeout"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                        <telerik:GridViewDataColumn
                            Width="*"
                            Header="Parameters"
                            IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <q:QTextBox
                                        VerticalAlignment="Center"
                                        Text="{Binding AdditionalInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="GotKeyboardFocus">
                                                <i:InvokeCommandAction
                                                    Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                    CommandParameter="{Binding}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </q:QTextBox>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel
                Margin="8"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <telerik:RadButton
                    MinWidth="82"
                    Margin="0,0,8,0"
                    Content="Apply"
                    Command="{Binding ApplyCommand}"/>
                <telerik:RadButton
                    MinWidth="82"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
