<UserControl x:Class="Qenex.QInsight.Views.AboutAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Qenex.QInsight.Views"
        xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Height="350" Width="650"
        d:DataContext="{d:DesignInstance vm:AboutAppViewModel, IsDesignTimeCreatable=False}">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="5" Width="300" Height="300" 
                BorderBrush="Black" BorderThickness="1">
            <Image Margin="2" Source="/Icons/About.png"/>
        </Border>


        <StackPanel Grid.Column="1" Grid.Row="0"  DockPanel.Dock="Top" Orientation="Vertical">
            <TextBlock  Text="QInsight" FontSize="52" FontFamily="Segoe UI Light" FontWeight="Bold" FontStyle="Normal" Foreground="DodgerBlue"
                        HorizontalAlignment="Center"/>
            <TextBlock  Margin="0,20,0,0" Text="...tune / debug / log and process data" 
                        FontSize="15" FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"/>
            <TextBlock  Margin="0,5,0,0" Text="of your electronic devices" 
                        HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" FontStyle="Italic"/>
            <TextBlock  Margin="0,5,0,0" Text="in real-time!" 
                        HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" FontStyle="Italic"/>

            <StackPanel Orientation="Horizontal" Margin="00,35,0,0" HorizontalAlignment="Center">
                <TextBlock  Text="Version:" FontSize="14" FontWeight="Normal" FontStyle="Normal"/>
                <TextBlock  Margin="10,0,0,0" Text="{Binding Version}" FontSize="14" FontWeight="Bold" FontStyle="Normal"/>
            </StackPanel>
            <TextBlock  Margin="0,5,0,0" Text="QENEX s.r.o." FontSize="14" 
                        HorizontalAlignment="Center" FontWeight="Normal" FontStyle="Normal"/>
            <TextBlock  Margin="0,5,0,0" Text="{Binding Copyright}" 
                        HorizontalAlignment="Center" FontSize="14" FontWeight="Normal" FontStyle="Normal"/>
        </StackPanel>

        <Button Grid.Column="1" Grid.Row="1" Margin="10,10,10,10" Content="Close" DockPanel.Dock="Bottom" Width="70">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <i:InvokeCommandAction Command="{Binding CloseCommand}" PassEventArgsToCommand="True"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>

    </Grid>
</UserControl>