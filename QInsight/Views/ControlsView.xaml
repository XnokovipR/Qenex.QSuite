<UserControl x:Class="Qenex.QInsight.Views.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Qenex.QInsight.Views"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:dragdrop="clr-namespace:Qenex.QInsight.DragDrop"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:ControlsViewModel, IsDesignTimeCreatable=False}">
    
    <UserControl.Resources>
        <Style TargetType="telerik:RadListBoxItem" BasedOn="{StaticResource RadListBoxItemStyle}">
            <Setter Property="telerik:DragDropManager.AllowDrag" Value="True"/>
            <Setter Property="telerik:DragDropManager.AllowCapturedDrag" Value="True"/>
        </Style>
        
        <DataTemplate x:Key="ControlItemTemplate">
            <StackPanel Orientation="Horizontal" Height="20" ToolTip="{Binding Description}">
                <Image Source="{Binding Icon}" Margin="5,0,10,0"/>
                <TextBlock Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding UserControlLoadedCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <telerik:RadListBox x:Name="Controls" AllowDrop="False" 
                        ItemsSource="{Binding Controls}"
                        ItemTemplate="{StaticResource ControlItemTemplate}">
        
        <i:Interaction.Behaviors>
            <dragdrop:ControlsDragBehavior />
        </i:Interaction.Behaviors>
        
    </telerik:RadListBox>
</UserControl>
