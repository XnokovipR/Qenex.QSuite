<UserControl x:Class="Qenex.QInsight.Views.ScriptLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Qenex.QInsight.Views"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScriptLogsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="300" d:DesignWidth="300"
             >
    <Grid>
        <q:QTextBox Text="{Binding LogText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 BorderThickness="0"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 local:TextBoxAutoScrollBehavior.AutoScroll="True"
                 Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"
                 Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}">
    
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Clear All"
                              Command="{Binding ClearLogCommand}" />
                </ContextMenu>
            </TextBox.ContextMenu>
        </q:QTextBox>
    </Grid>
</UserControl>
