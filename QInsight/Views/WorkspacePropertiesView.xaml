<UserControl x:Class="Qenex.QInsight.Views.WorkspacePropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Qenex.QInsight.Views"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:inp="clr-namespace:Qenex.QSuite.Common.InpBindingManager;assembly=Qenex.QSuite.Common.InpBindingManager"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:WorkspacePropertiesViewModel, IsDesignTimeCreatable=False}">
    
    <StackPanel Orientation="Vertical" Margin="5">
        <q:QTextBlock Text="Workspace Title" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,5"/>
        <q:QTextBox Text="{Binding WorkspaceTitle, Mode=TwoWay}"
                    inp:InputManager.UpdatePropertySourceWhenEnterPressed="q:QTextBox.Text"/>
    </StackPanel>
</UserControl>
