<UserControl x:Class="Qenex.QInsight.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:primitives="clr-namespace:Telerik.Windows.Controls.Diagrams.Primitives;assembly=Telerik.Windows.Controls.Diagrams"
             xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
             xmlns:local="clr-namespace:Qenex.QInsight.Views"
             d:DataContext="{d:DesignInstance vm:WorkspaceViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

    <!-- <i:Interaction.Triggers> -->
    <!--     <i:EventTrigger EventName="Loaded"> -->
    <!--         <i:InvokeCommandAction Command="{Binding UserControlLoadedCommand}" CommandParameter="{Binding ElementName=RadDiagram}"/> -->
    <!--     </i:EventTrigger> -->
    <!-- </i:Interaction.Triggers> -->
    
    <telerik:RadDiagram
        Name="RadDiagram"
        primitives:BackgroundGrid.IsDynamic="True"
        primitives:BackgroundGrid.LineStroke="WhiteSmoke">
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding UserControlLoadedCommand}"
                                       CommandParameter="{Binding ElementName=RadDiagram}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
    </telerik:RadDiagram>
</UserControl>
 