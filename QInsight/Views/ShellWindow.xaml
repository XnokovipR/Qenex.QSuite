<Window x:Class="Qenex.QInsight.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Qenex.QInsight.Views"
		xmlns:vm="clr-namespace:Qenex.QInsight.ViewModels"
		xmlns:converters="clr-namespace:Qenex.QInsight.Converters"
		xmlns:behaviors="clr-namespace:Qenex.QInsight.Behaviors"
		xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
		xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
		xmlns:inp="clr-namespace:Qenex.QSuite.Common.InpBindingManager;assembly=Qenex.QSuite.Common.InpBindingManager"
        xmlns:qui="clr-namespace:Qenex.QLibs.QUI.TelerikDocking;assembly=Qenex.QLibs.QUI.TelerikDocking"
		xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellWindowModel, IsDesignTimeCreatable=False}"
        Background="{DynamicResource AppBorderBrush}"
        Title="{Binding WindowTitle}" Height="450" Width="800">

	<Window.Resources>
		<converters:FontScaledRibbonWidthConverter x:Key="ReplayTimelineWidthConverter"
		                                           ReservedWidth="170"
		                                           ReferenceFontSize="12"
		                                           MinWidth="560"/>
		<converters:RibbonRemainingWidthConverter x:Key="ReplayDataContentWidthConverter"
		                                          ReservedWidth="32"
		                                          MinWidth="520"/>
		<converters:FontSizeToWidthConverter x:Key="ReplaySeekBoxWidthConverter" Factor="7.4"/>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
	</Window.Resources>
	
	<Window.DataContext>
		<vm:ShellWindowModel/>
	</Window.DataContext>
	
	<i:Interaction.Triggers>
		<i:EventTrigger EventName="Loaded">
			<i:InvokeCommandAction Command="{Binding ShellWindowLoadedCommandAsync}" CommandParameter="{Binding ElementName=RadDocking}"/>
		</i:EventTrigger>

		<i:EventTrigger EventName="Closing">
			<i:InvokeCommandAction Command="{Binding ShellWindowClosingCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
		</i:EventTrigger>

		<i:EventTrigger EventName="SizeChanged">
			<i:InvokeCommandAction Command="{Binding ShellWindowSizeChangedCommand}"/>
		</i:EventTrigger>

		<i:EventTrigger EventName="LocationChanged">
			<i:InvokeCommandAction Command="{Binding ShellWindowLocationChangedCommand}"/>
		</i:EventTrigger>
	</i:Interaction.Triggers>
	
	<Border x:Name="CustomBorder"
	        BorderThickness="1"
	        CornerRadius="0"
	        Background="Transparent"
	        BorderBrush="{DynamicResource AppBorderBrush}">
		
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>	
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			
			<telerik:RadRibbonView x:Name="RibbonMenu" Grid.Row="0"
			                       TitleBarVisibility="Collapsed" ContentHeight="NaN" ApplicationButtonVisibility="Collapsed">

				<telerik:RadRibbonView.Items>
					<!-- Ribbon Menu - Home -->
					<telerik:RadRibbonTab Header="Home" x:Name="HomeTab">
						<telerik:RadRibbonGroup Header="Project">
							<telerik:RadRibbonButton
	                            Text="New" 
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/Project.png"
	                            Command="{Binding RibbonNewProjectCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
							<telerik:RadRibbonButton
	                            Text="Open" 
	                            Size="Large"
	                            SmallImage="../Icons/Menu/OpenProject.png"
	                            Command="{Binding RibbonOpenProjectCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
							<telerik:RadRibbonButton
								Text="Save" 
								Size="Large"
								SmallImage="../Icons/Menu/SaveProject.png"
								Command="{Binding RibbonSaveProjectCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
							<telerik:RadRibbonButton
								Text="Save as" 
								Size="Large"
								SmallImage="../Icons/Menu/SaveProjectAs.png"
								Command="{Binding RibbonSaveProjectAsCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
							<telerik:RadRibbonButton
	                            Text="Close" 
	                            Size="Large"
	                            SmallImage="../Icons/Menu/CloseProject.png"
	                            Command="{Binding RibbonCloseProjectCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
						</telerik:RadRibbonGroup>

						<telerik:RadRibbonGroup Header="Workspace">
							<telerik:RadRibbonButton
	                            Text="Add" 
	                            Size="Large"
	                            SmallImage="../Icons/Menu/AddWorkspace.png"
	                            Command="{Binding RibbonAddWorkspaceCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
							<telerik:RadRibbonButton
	                            Text="Remove"
	                            Size="Large" 
	                            SmallImage="../Icons/Menu/RemoveWorkspace.png"
	                            Command="{Binding RibbonRemoveWorkspaceCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
						</telerik:RadRibbonGroup>

						<telerik:RadRibbonGroup Header="Project Configuration">
							<telerik:RadRibbonButton
								Text="Project"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Project.png"
								Command="{Binding RibbonProjectConfigurationProjectCommand}"/>
							<telerik:RadRibbonButton
								Text="Drivers"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Drivers.png"
								Command="{Binding RibbonProjectConfigurationDriversCommand}"/>
							<telerik:RadRibbonButton
								Text="Protocols"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Protocols.png"
								Command="{Binding RibbonProjectConfigurationDriversCommand}"/>
							<telerik:RadRibbonButton
								Text="Events"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Events.png"
								Command="{Binding RibbonProjectConfigurationEventsCommand}"/>
							<telerik:RadRibbonButton
								Text="Variables"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Variables.png"
								Command="{Binding RibbonProjectConfigurationVariablesCommand}"/>
							<telerik:RadRibbonButton
								Text="Presentations"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Presentations.png"
								Command="{Binding RibbonProjectConfigurationPresentationsCommand}"/>
							<telerik:RadRibbonButton
								Text="Conversions"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Presentations.png"
								Command="{Binding RibbonProjectConfigurationConversionsCommand}"/>
							<telerik:RadRibbonButton
								Text="Scripts"
								Size="Large"
								SmallImage="../Icons/Menu/ScriptSettings.png"
								Command="{Binding RibbonProjectConfigurationScriptsCommand}"/>
						</telerik:RadRibbonGroup>
					</telerik:RadRibbonTab>

					<!-- Ribbon Menu - Runtime -->
					<telerik:RadRibbonTab Header="Runtime" x:Name="RuntimeTab">
						<telerik:RadRibbonGroup Header="Run">
							<telerik:RadRibbonButton
								Text="Connect"
								Size="Large" 
	                            SmallImage="../Icons/Menu/Connect.png"
								Command="{Binding RibbonConnectCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
							<telerik:RadRibbonButton
	                            Text="Disconnect" 
	                            Size="Large"
	                            SmallImage="../Icons/Menu/Disconnect.png"
	                            Command="{Binding RibbonDisconnectCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
						</telerik:RadRibbonGroup>
						<telerik:RadRibbonGroup x:Name="ReplayDataGroup"
						                        DefaultVariant="Large">
							<telerik:RadRibbonGroup.Width>
								<!-- The reserve for the Run group scales with the theme font (the app applies
								     the font via the Telerik palette, not WPF inheritance). Deliberately no
								     ActualWidth of another group here: that feeds the ribbon layout back into
								     itself and collapses the group. -->
								<MultiBinding Converter="{StaticResource ReplayTimelineWidthConverter}">
									<Binding Path="ActualWidth" ElementName="RibbonMenu"/>
									<Binding Source="{x:Static telerik:Windows11Palette.Palette}" Path="FontSize"/>
								</MultiBinding>
							</telerik:RadRibbonGroup.Width>
							<telerik:RadRibbonGroup.Variants>
								<telerik:GroupVariant Variant="Large" Priority="100" />
							</telerik:RadRibbonGroup.Variants>
							<telerik:RadRibbonGroup.Header>
								<TextBlock Text="Replay data"
								           Width="{Binding ActualWidth, ElementName=ReplayDataGroup, Converter={StaticResource ReplayDataContentWidthConverter}}"
								           Margin="2,0,0,0"
								           TextAlignment="Left"/>
							</telerik:RadRibbonGroup.Header>
							<Grid Margin="2,0,6,0"
							      Width="{Binding ActualWidth, ElementName=ReplayDataGroup, Converter={StaticResource ReplayDataContentWidthConverter}}"
							      HorizontalAlignment="Left">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel Orientation="Horizontal">
									<telerik:RadRibbonButton
										Text="Import"
										Size="Large"
										SmallImage="../Icons/Menu/OpenProject.png"
										Command="{Binding RibbonImportDataLogCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
									<telerik:RadRibbonButton
										Text="Stop loading"
										Size="Large"
										SmallImage="../Icons/Menu/Disconnect.png"
										Command="{Binding RibbonCancelReplayDataLoadCommand}"/>
									<telerik:RadRibbonButton
										Text="Export"
										Size="Large"
										SmallImage="../Icons/Menu/SaveProjectAs.png"
										Command="{Binding RibbonExportDataLogCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
									<telerik:RadRibbonButton
										Text="Replay"
										Size="Large"
										SmallImage="../Icons/Menu/Connect.png"
										Command="{Binding RibbonReplayCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
									<telerik:RadRibbonButton
										Text="Stop"
										Size="Large"
										SmallImage="../Icons/Menu/Disconnect.png"
										Command="{Binding RibbonStopReplayCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
									<telerik:RadRibbonButton
										Text="{Binding ReplayPauseResumeText}"
										Size="Large"
										SmallImage="../Icons/Menu/Pause.png"
										Command="{Binding RibbonReplayPauseResumeCommand}"
										IsEnabled="{Binding IsReplayControlEnabled}"/>
								</StackPanel>

								<Grid Grid.Column="1">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<TextBlock Margin="10,0,8,0"
									           VerticalAlignment="Center"
									           IsEnabled="{Binding IsReplayControlEnabled}"
									           Text="{Binding ReplayCurrentTimeText}"/>
									<q:QTextBox Grid.ColumnSpan="2"
									            Width="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=FontSize, Converter={StaticResource ReplaySeekBoxWidthConverter}}"
									            HorizontalAlignment="Center"
									            VerticalAlignment="Center"
									            VerticalContentAlignment="Center"
									            TextAlignment="Center"
									            IsEnabled="{Binding IsReplaySeekEnabled}"
									            Text="{Binding ReplayPositionText, Mode=TwoWay}"
									            inp:InputManager.UpdatePropertySourceWhenEnterPressed="q:QTextBox.Text"/>
									<TextBlock Grid.Column="1"
									           Margin="8,0,4,0"
									           VerticalAlignment="Center"
									           IsEnabled="{Binding IsReplayControlEnabled}"
									           Text="{Binding ReplayDurationText}"/>
									<telerik:RadSlider Grid.Row="1"
									                   Grid.ColumnSpan="2"
									                   Margin="10,4,4,0"
									                   VerticalAlignment="Top"
									                   Minimum="0"
									                   Maximum="{Binding ReplayDurationSeconds}"
									                   SmallChange="1"
									                   LargeChange="10"
									                   IsEnabled="{Binding IsReplaySeekEnabled}"
									                   Value="{Binding ReplayPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
								</Grid>
							</Grid>
						</telerik:RadRibbonGroup>
					</telerik:RadRibbonTab>
					
					<!-- Tools-->
					<telerik:RadRibbonTab Header="Tools" x:Name="ToolsTab">
						<telerik:RadRibbonGroup Header="Interpreter">
							<telerik:RadRibbonButton
								Text="Python"
								Size="Large"
								SmallImage="../Icons/Menu/ScriptSettings.png"
								Command="{Binding RibbonPythonInterpreterCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
						</telerik:RadRibbonGroup>
						<telerik:RadRibbonGroup Header="Watch">
							<telerik:RadRibbonButton
								Text="Variables"
								Size="Large"
								SmallImage="../Icons/SolutionExplorer/Variables.png"
								Command="{Binding RibbonVariableWatchCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
						</telerik:RadRibbonGroup>
					</telerik:RadRibbonTab>
					
					<!-- Options-->
					<telerik:RadRibbonTab Header="Options" x:Name="OptionsTab">
						<telerik:RadRibbonGroup Header="Layout">
							<telerik:RadRibbonButton
								Text="Save" 
								Size="Large"
								SmallImage="../Icons/Menu/SaveLayout.png"
								Command="{Binding RibbonSaveLayoutCommand}" CommandParameter="{Binding ElementName=RadDocking}"/>
						</telerik:RadRibbonGroup>
						<telerik:RadRibbonGroup Header="Preferences">
							<telerik:RadRibbonButton
								Text="Theme"
								Size="Large"
								SmallImage="../Icons/Menu/Theme.png"
								Command="{Binding RibbonThemePreferencesCommand}"/>
							<telerik:RadRibbonButton
								Text="General"
								Size="Large"
								SmallImage="../Icons/Menu/GeneralPreferences.png"
								Command="{Binding RibbonGeneralPreferencesCommand}"/>
						</telerik:RadRibbonGroup>
					</telerik:RadRibbonTab>

                    <!-- Ribbon Menu - Help -->
                    <telerik:RadRibbonTab Header="Help" x:Name="HelpTab">
                        <telerik:RadRibbonGroup Header="Info">
                            <telerik:RadRibbonButton
	                            Text="License"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/License.png"
	                            Command="{Binding RibbonLicenseCommand}"/>
                            <telerik:RadRibbonButton
	                            Text="About"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/AboutApp.png"
	                            Command="{Binding RibbonAboutAppCommand}"/>
                        </telerik:RadRibbonGroup>
                        <!-- Online documentation on qinsight.qenex.net; the parameter is the section slug -->
                        <telerik:RadRibbonGroup Header="Getting Started">
                            <telerik:RadRibbonButton
	                            Text="Getting Started"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/HelpGettingStarted.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="getting-started/what-is-qenex-suite"/>
                            <telerik:RadRibbonButton
	                            Text="First Project"
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/Project.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="first-project/create-a-project"/>
                            <telerik:RadRibbonButton
	                            Text="Connecting a Device"
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/Drivers.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="connecting-a-device/add-a-driver"/>
                        </telerik:RadRibbonGroup>
                        <telerik:RadRibbonGroup Header="User Guide">
                            <telerik:RadRibbonButton
	                            Text="Variables"
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/Variable.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="variables/what-is-a-variable"/>
                            <telerik:RadRibbonButton
	                            Text="Visualization"
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/Presentations.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="visualization/create-a-workspace"/>
                            <telerik:RadRibbonButton
	                            Text="Running"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/Connect.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="running/start-and-stop"/>
                            <telerik:RadRibbonButton
	                            Text="Logging &amp; Replay"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/HelpLogging.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="logging-and-replay/logging-data"/>
                            <telerik:RadRibbonButton
	                            Text="Python Scripts"
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/ScriptFile.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="python-scripts/scripts-overview"/>
                        </telerik:RadRibbonGroup>
                        <telerik:RadRibbonGroup Header="Advanced">
                            <telerik:RadRibbonButton
	                            Text="Custom Extensions"
	                            Size="Large"
	                            SmallImage="../Icons/SolutionExplorer/Protocols.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="custom-extensions/custom-driver"/>
                            <telerik:RadRibbonButton
	                            Text="Reference"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/HelpReference.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="reference/drivers"/>
                            <telerik:RadRibbonButton
	                            Text="Examples"
	                            Size="Large"
	                            SmallImage="../Icons/Menu/HelpExamples.png"
	                            Command="{Binding RibbonOpenDocumentationCommand}" CommandParameter="examples/filter-script"/>
                        </telerik:RadRibbonGroup>
                    </telerik:RadRibbonTab>
                </telerik:RadRibbonView.Items>
			</telerik:RadRibbonView>

			<!-- Free-license badge: top-right corner of the ribbon row, directly below the
			     window close button (the native title bar cannot host WPF content).
			     With a project open it shows the communicated-signal counter; red = over limit. -->
			<q:QTextBlock Grid.Row="0"
			              HorizontalAlignment="Right"
			              VerticalAlignment="Top"
			              Margin="0,6,10,0"
			              FontWeight="SemiBold"
			              IsHitTestVisible="False"
			              Text="{Binding LicenseBadgeText}"
			              Visibility="{Binding IsFreeLicense, Converter={StaticResource BoolToVisibility}}">
				<q:QTextBlock.Style>
					<Style TargetType="{x:Type q:QTextBlock}">
						<Setter Property="Foreground" Value="DarkOrange"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsLicenseBadgeAlert}" Value="True">
								<Setter Property="Foreground" Value="Red"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</q:QTextBlock.Style>
			</q:QTextBlock>

			<telerik:RadDocking
				x:Name="RadDocking"
				Grid.Row="1"
				CloseButtonPosition="InPaneAndGroup"
				AllowDragReorder="True" 
				behaviors:ActiveDocumentPaneHighlightBehavior.IsEnabled="True"
				PanesSource="{Binding ViewModels}">
				
				<telerik:EventToCommandBehavior.EventBindings>
					<telerik:EventBinding Command="{Binding PanelCloseCommandAsync}"
					                      EventName="Close"
					                      PassEventArgsToCommand="True"/>
					<telerik:EventBinding Command="{Binding DockingElementLayoutCleaningCommand}"
					                      EventName="ElementLayoutCleaning"
					                      PassEventArgsToCommand="True"/>
					<telerik:EventBinding Command="{Binding DockingElementLayoutSavingCommand}"
					                      EventName="ElementLayoutSaving"
					                      PassEventArgsToCommand="True"/>
				</telerik:EventToCommandBehavior.EventBindings>

				<telerik:RadDocking.DocumentHost>
					<telerik:RadSplitContainer InitialPosition="DockedTop" telerik:RadDocking.SerializationTag="WorkspaceViewModelSplitContainer">
					</telerik:RadSplitContainer>
				</telerik:RadDocking.DocumentHost>
				
				<telerik:RadSplitContainer InitialPosition="DockedLeft" telerik:RadDocking.SerializationTag="DockedLeft">
					<telerik:RadPaneGroup x:Name="LeftPaneGroup" telerik:RadDocking.SerializationTag="LeftPaneGroup"/>
				</telerik:RadSplitContainer>
				
				<telerik:RadSplitContainer InitialPosition="DockedRight" telerik:RadDocking.SerializationTag="DockedRight">
					<telerik:RadPaneGroup x:Name="RightPaneGroup" telerik:RadDocking.SerializationTag="RightPaneGroup"/>
				</telerik:RadSplitContainer>
				
				<telerik:RadSplitContainer InitialPosition="DockedBottom" telerik:RadDocking.SerializationTag="DockedBottom">
					<telerik:RadPaneGroup x:Name="BottomPaneGroup" telerik:RadDocking.SerializationTag="BottomPaneGroup"/>
				</telerik:RadSplitContainer>

				<telerik:RadDocking.DockingPanesFactory>
					<qui:TelerikDockingPanesFactory/>
				</telerik:RadDocking.DockingPanesFactory>

			</telerik:RadDocking>

		</Grid>
	</Border>

</Window>
