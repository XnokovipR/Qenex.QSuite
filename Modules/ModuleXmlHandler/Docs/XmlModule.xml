<?xml version="1.0" encoding="utf-8"?>
<module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="UnifiedModule" label="Test module">
  <description>This is a test module</description>
  <version>1.0.0</version>
  <author>Qenex</author>
  <company>QENEX Ltd.</company>
  <createdOn>2024-11-27T00:00:00</createdOn>
  <driverReferences>
    <driverReference ref="SimulDataDriver" label="Simulation driver">
      <isEnabled>true</isEnabled>
      <settings>periodes=20</settings>
      <encryptedSettings />
      <protocolReferences>
        <protocolReference ref="SimpleO2OProtocol">
          <isEnabled>true</isEnabled>
          <settings />
          <encryptedSettings />
          <variableReferences>
            <variableReference ref="1" isCommunicated="true">
              <commParam>direction="read";eventRef="Event20ms";multiplier="1";id="OilTemp"</commParam>
			  <script ref="valuechanged_oiltemp.py" additionalInfo="threshold=1700.0"/>
            </variableReference>
            <variableReference ref="2" isCommunicated="true">
              <commParam>direction="read";eventRef="Event20ms";multiplier="1";id="OilPressure"</commParam>
            </variableReference>
            <variableReference ref="3" isCommunicated="true">
              <commParam>direction="read";eventRef="Event20ms";multiplier="1";id="MachineState"</commParam>
            </variableReference>
          </variableReferences>
        </protocolReference>
      </protocolReferences>
    </driverReference>
    <driverReference ref="FileDataLoggerDriver" label="File data logger">
      <isEnabled>true</isEnabled>
      <settings>file=DataLogs\values.msgpack;append=true;flushOnWrite=false</settings>
      <encryptedSettings />
      <protocolReferences>
        <protocolReference ref="One2OneProtocol">
          <isEnabled>true</isEnabled>
          <settings />
          <encryptedSettings />
          <variableReferences>
            <variableReference ref="1" isCommunicated="true">
              <commParam />
            </variableReference>
            <variableReference ref="2" isCommunicated="true">
              <commParam />
            </variableReference>
            <variableReference ref="3" isCommunicated="true">
              <commParam />
            </variableReference>
          </variableReferences>
        </protocolReference>
      </protocolReferences>
    </driverReference>
    <driverReference ref="FileDataReplayDriver" label="File data replay">
      <isEnabled>false</isEnabled>
      <settings>file=DataLogs\values.msgpack;mode=realtime;speed=1;loop=false</settings>
      <encryptedSettings />
      <protocolReferences>
        <protocolReference ref="DataLogReplayProtocol">
          <isEnabled>false</isEnabled>
          <settings />
          <encryptedSettings />
          <variableReferences>
            <variableReference ref="1" isCommunicated="true">
              <commParam />
            </variableReference>
            <variableReference ref="2" isCommunicated="true">
              <commParam />
            </variableReference>
            <variableReference ref="3" isCommunicated="true">
              <commParam />
            </variableReference>
          </variableReferences>
        </protocolReference>
      </protocolReferences>
    </driverReference>
  </driverReferences>
  <drivers>
    <driver id="1" name="SimulDataDriver">
      <version>1.0.0.0</version>
    </driver>
    <driver id="2" name="FileDataLoggerDriver">
      <version>1.0.0.0</version>
    </driver>
    <driver id="3" name="FileDataReplayDriver">
      <version>1.0.0.0</version>
    </driver>
  </drivers>
  <protocols>
    <protocol id="1" name="SimpleO2OProtocol" label="Simple One to One Protocol">
      <version>1.0.0.0</version>
    </protocol>
    <protocol id="2" name="One2OneProtocol" label="One2One Protocol">
      <version>1.0.0.0</version>
    </protocol>
    <protocol id="3" name="DataLogReplayProtocol" label="Data Log Replay Protocol">
      <version>1.0.0.0</version>
    </protocol>
  </protocols>
  <presentations>
    <presentation name="IntTemperature" label="Temperature" min="0" max="1000" printFormat="" unit="°C">
      <conversionReference ref="OneToOne" />
    </presentation>
    <presentation name="FloatPressure" label="Pressure" min="0" max="1000" printFormat="" unit="Pa">
      <conversionReference ref="OneToOne" />
    </presentation>
    <presentation name="EngineState" label="Engine state" min="0" max="0" printFormat="" unit="">
      <conversionReference ref="EngineState" />
    </presentation>
  </presentations>
  <conversions>
    <linearConversion name="OneToOne" multiplier="1" offset="0" />
    <enumConversion name="EngineState">
      <enums>
        <enum name="Stopped" value="0" />
        <enum name="Starting" value="1" />
        <enum name="Running" value="2" />
        <enum name="Stopping" value="3" />
      </enums>
    </enumConversion>
  </conversions>
  <variableEvents>
    <periodicVariableEvent name="Event20ms" period="20" unit="Milisec" />
    <periodicVariableEvent name="Event3s" period="3" unit="Sec" />
    <periodicVariableEvent name="Event1s" period="1" unit="Sec" />
    <onRequestVariableEvent name="OnRequestEvent1" />
    <onValueChangedVariableEvent name="OnValueChangedEvent1" threshold="3.14" />
    <onValueChangedVariableEvent name="OnValueChangedEvent2" threshold="10" />
  </variableEvents>
  <variables>
    <scalarVariable id="1" namespace="/Engine" name="OilTemp" label="Oil Temperature" size="4">
      <description>Oil Temperature </description>
      <values dataType="int" size="4" length="1">
        <presentationReference ref="IntTemperature" />
      </values>
    </scalarVariable>
    <scalarVariable id="2" namespace="/Engine" name="OilPressure" label="Oil Pressure" size="4">
      <description>Oil pressure</description>
      <values dataType="float" size="4" length="1">
        <presentationReference ref="FloatPressure" />
      </values>
    </scalarVariable>
    <scalarVariable id="3" namespace="/" name="MachineState" label="Machine state" size="1">
      <description>Main machine enum states</description>
      <values dataType="byte" size="1" length="1">
        <presentationReference ref="EngineState" />
      </values>
    </scalarVariable>
    <stringVariable id="4" namespace="/Info" name="AlertMsg" label="Alert Message">
      <description>Details about warnings/errors</description>
    </stringVariable>
    <scalarVariable id="5" namespace="/Inlet" name="AirPressure" label="Air Pressure" size="4">
      <description>Air pressure</description>
      <values dataType="float" size="4" length="1">
        <presentationReference ref="FloatPressure" />
      </values>
    </scalarVariable>
  </variables>
  <scripts>
    <script fileName="startup.py" content="" executionMode="Startup" additionalInfo="" />
    <script fileName="shutdown.py" content="" executionMode="Shutdown" additionalInfo="" />
    <script fileName="periodic.py" content="" executionMode="Periodic" additionalInfo="period=2;unit=s" />
	<script fileName="valuechanged_oiltemp.py" executionMode="OnValueChanged" />
  </scripts>
</module>
