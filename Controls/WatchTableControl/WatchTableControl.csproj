<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Qenex.QSuite.Controls.WatchTableControl</AssemblyName>
        <RootNamespace>Qenex.QSuite.Controls.WatchTableControl</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Common\WpfComm\WpfComm.csproj" />
      <ProjectReference Include="..\..\Variables\QVariables\QVariables.csproj" />
      <ProjectReference Include="..\Control\Control.csproj" />
      <ProjectReference Include="..\DerivedWinControls\DerivedWinControls.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Qenex.QLibs.QUI" Version="1.0.10" />
      <PackageReference Include="Telerik.Windows.Controls.for.Wpf" Version="2026.1.415" />
      <PackageReference Include="Telerik.Windows.Controls.GridView.for.Wpf" Version="2026.1.415" />
      <PackageReference Include="Telerik.Windows.Data.for.Wpf" Version="2026.1.415" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Icons\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Icons\WatchTable.png" />
      <Resource Include="Icons\WatchTable.png" />
    </ItemGroup>

    <!-- Plugin deploy: zkopiruj control DLL do QInsight\...\Controls (nacita se dynamicky, ne pres ProjectReference) -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="xcopy /Y &quot;$(TargetPath)&quot; &quot;..\..\QInsight\bin\$(Configuration)\net10.0-windows\Controls\&quot;" />
    </Target>

    <PropertyGroup>
        <EazfuscatorIntegration>MSBuild</EazfuscatorIntegration>
        <EazfuscatorActiveConfigurations>Debug;Release</EazfuscatorActiveConfigurations>
    </PropertyGroup>

    <!-- Eazfuscator.NET: obfuscation as a build step (only when the tool is installed) -->
    <Import Condition="'$(EAZFUSCATOR_NET_HOME)' != '' and Exists('$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets')"
            Project="$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets" />

</Project>
