<UserControl x:Class="Qenex.QSuite.Controls.GraphControl.Views.GraphControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:q="clr-namespace:Qenex.QSuite.Controls.OverridenWinControls;assembly=Qenex.QSuite.Controls.OverridenWinControls"
             xmlns:local="clr-namespace:Qenex.QSuite.Controls.GraphControl.Views"
             xmlns:vm="clr-namespace:Qenex.QSuite.Controls.GraphControl.ViewModels"
             d:DataContext="{d:DesignInstance vm:GraphControlViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Qenex.QSuite.Controls.Control;component/Style/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <telerik:RadExpander Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SquareExpanderStyle}"
                             HorizontalAlignment="Left">
            <telerik:RadTabControl BackgroundVisibility="Collapsed">
                <telerik:RadTabControl.Items>
                    <telerik:RadTabItem Header="General">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <q:QTextBlock Grid.Column="0" Grid.Row="0" Margin="0,0,0,0" Text="Lock:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Grid.Row="0" Margin="5,0,0,0" IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                      VerticalAlignment="Center" MinHeight="0" Padding="0" MinWidth="0"/>
                            
                            <q:QTextBlock Grid.Column="0" Grid.Row="1" Margin="0,3,0,0" Text="Title:" HorizontalAlignment="Left"/>
                            <q:QTextBox Grid.Column="1" Grid.Row="1" Text="{Binding ChartTitle, Mode=TwoWay}"
                                        Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="180" />

                            <q:QTextBlock Grid.Column="0" Grid.Row="2" Margin="0,3,0,0" Text="Buffer [ms]:" HorizontalAlignment="Left"/>
                            <q:QTextBox Grid.Column="1" Grid.Row="2" Text="{Binding ChartBuffer, Mode=TwoWay}"
                                             Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50" />

                            <q:QTextBlock Grid.Column="0" Grid.Row="3" Margin="0,3,0,0" Text="Time span [s]:" HorizontalAlignment="Left"/>
                            <q:QTextBox Grid.Column="1" Grid.Row="3" Text="{Binding ChartTimeSpan, Mode=TwoWay}" 
                                             Margin="8,3,0,0" HorizontalAlignment="Left" Height="20" Width="50"/>
                        </Grid>       
                    </telerik:RadTabItem>
                    
                    <telerik:RadTabItem Header="Signals">
                        <telerik:RadGridView
                            AllowDrop="False"
                            ItemsSource="{Binding ChartVariables, Mode=TwoWay}"
                            ShowGroupPanel="False" 
                            AutoGenerateColumns="False"
                            RowIndicatorVisibility="Collapsed">
                            
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Id" IsFilterable="False" DataMemberBinding="{Binding Path=Variable.Id}" IsReadOnly="True"/>
                                <telerik:GridViewDataColumn Header="Label" IsFilterable="False" DataMemberBinding="{Binding Path=Variable.Label}" IsReadOnly="True"/>
                                <telerik:GridViewDataColumn Header="Color" IsFilterable="False" >
                                    <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <telerik:RadColorPicker 
                                            SelectedColor="{Binding ChartColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            HeaderPalette="Standard" 
                                            HeaderPaletteVisibility="Visible" 
                                            MainPalette="Default" 
                                            StandardPalette="Standard" 
                                            StandardPaletteVisibility="Collapsed"
                                            NoColorText="Line Color"/>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellTemplate>
                                </telerik:GridViewDataColumn>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </telerik:RadTabItem>
                    
                    <telerik:RadTabItem Header="Axis">
                        <CheckBox/>
                        
                    </telerik:RadTabItem>
                </telerik:RadTabControl.Items>
            </telerik:RadTabControl>
        </telerik:RadExpander>
        
        <q:QTextBlock Grid.Row="0" Grid.Column="1" Margin="10,3,0,0" Text="{Binding ChartTitle, Mode=TwoWay}"
                      HorizontalAlignment="Center"/>
        
        <ContentControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding PlotControl, Mode=OneTime}"/>
    </Grid>
</UserControl>
