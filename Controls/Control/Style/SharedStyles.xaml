<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
	
	<Style TargetType="CheckBox"
	       BasedOn="{StaticResource CheckBoxStyle}">
		<Setter Property="Focusable" Value="False"/>
	</Style>
	
	<Style x:Key="SquareExpanderStyle" TargetType="telerik:RadExpander" 
           BasedOn="{StaticResource RadExpanderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HeaderButtonStyle">
            <Setter.Value>
                <Style TargetType="telerik:RadToggleButton">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="telerik:RadToggleButton">
                                <Border x:Name="ButtonBorder"
                                        Background="Transparent"
                                        BorderBrush="#888"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="arrow"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="#999"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Data="M 0,0 L 4,5 L 8,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="arrow" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="arrow" Property="Stroke" Value="#CCC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
	
</ResourceDictionary>