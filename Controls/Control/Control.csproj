<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Qenex.QSuite.Controls.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Qenex.QSuite.Controls.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Qenex.QLibs.QUI" Version="1.0.10" />
    <PackageReference Include="Telerik.Windows.Controls.Diagrams.for.Wpf" Version="2026.1.415" />
    <PackageReference Include="Telerik.Windows.Controls.FileDialogs.for.Wpf" Version="2026.1.415" />
    <PackageReference Include="Telerik.Windows.Controls.for.Wpf" Version="2026.1.415" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Protocols\Protocol\Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Style\SharedStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

    <PropertyGroup>
        <EazfuscatorIntegration>MSBuild</EazfuscatorIntegration>
        <EazfuscatorActiveConfigurations>Debug;Release</EazfuscatorActiveConfigurations>
    </PropertyGroup>

    <!-- Eazfuscator.NET: obfuscation as a build step (only when the tool is installed) -->
    <Import Condition="'$(EAZFUSCATOR_NET_HOME)' != '' and Exists('$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets')"
            Project="$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets" />

</Project>
