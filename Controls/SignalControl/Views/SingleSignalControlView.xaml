<UserControl x:Class="Qenex.QSuite.Controls.SingleSignalControl.Views.SingleSignalControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Qenex.QSuite.Controls.SingleSignalControl.Views"
             xmlns:vm="clr-namespace:Qenex.QSuite.Controls.SingleSignalControl.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance vm:SingleSignalControlViewModel, IsDesignTimeCreatable=False}">
    
    <StackPanel 
        VerticalAlignment="Center" 
        HorizontalAlignment="Center" 
        Margin="5">
        
        <TextBlock Text="{Binding Variables[0].Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBox Text="{Binding Variables[0]}"></TextBox>
            <TextBlock Text="[" Margin="5,0,0,0"/>
            <TextBlock Text="{Binding Variables[0].Unit, Mode=TwoWay, UpdateSourceTrigger=Default}"/>
            <TextBlock Text="]"/>
        </StackPanel>
    </StackPanel>
</UserControl>
