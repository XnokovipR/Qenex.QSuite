<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Qenex.QSuite.Drivers.FileDataLoggerDriver</AssemblyName>
        <RootNamespace>Qenex.QSuite.Drivers.FileDataLoggerDriver</RootNamespace>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Driver\Driver.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MessagePack" Version="3.1.8" />
    </ItemGroup>

    <!-- The plugin goes to the scanned Drivers folder; its NuGet dependencies go to the app base
         directory, where the PluginLoader's resolver fallback finds them. -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <Exec Command="xcopy /Y &quot;$(TargetPath)&quot; &quot;..\..\QInsight\bin\$(Configuration)\net10.0-windows\Drivers\&quot;&#xA;xcopy /Y &quot;$(TargetDir)MessagePack*.dll&quot; &quot;..\..\QInsight\bin\$(Configuration)\net10.0-windows\&quot;&#xA;xcopy /Y &quot;$(TargetDir)Microsoft.NET.StringTools.dll&quot; &quot;..\..\QInsight\bin\$(Configuration)\net10.0-windows\&quot;&#xA;" />
    </Target>

    <PropertyGroup>
        <EazfuscatorIntegration>MSBuild</EazfuscatorIntegration>
        <EazfuscatorActiveConfigurations>Debug;Release</EazfuscatorActiveConfigurations>
    </PropertyGroup>

    <!-- Eazfuscator.NET: obfuscation as a build step (only when the tool is installed) -->
    <Import Condition="'$(EAZFUSCATOR_NET_HOME)' != '' and Exists('$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets')"
            Project="$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets" />

</Project>
