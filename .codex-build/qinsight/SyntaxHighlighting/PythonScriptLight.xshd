<?xml version="1.0"?>
<SyntaxDefinition name="Python" extensions=".py" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!-- Edit Color foreground values to customize AvalonEdit Python highlighting for light theme. -->
  <Color name="Comment" foreground="#008000" />
  <Color name="String" foreground="#001080" />
  <Color name="Keyword" foreground="#AF00DB" />
  <Color name="DeclarationKeyword" foreground="#FF0000" />
  <Color name="BuiltinFunction" foreground="#795E26" />
  <Color name="FunctionCall" foreground="#795E26" />
  <Color name="Type" foreground="#267F99" />
  <Color name="Constant" foreground="#0000FF" />
  <Color name="Number" foreground="#098658" />
  <Color name="Decorator" foreground="#AF00DB" />
  <Color name="ClassName" foreground="#267F99" />
  <Color name="Self" foreground="#0070C1" fontStyle="italic" />
  <Color name="EscapeSequence" foreground="#811F3F" />
  <Color name="FormatSpecifier" foreground="#FF0000" />

  <RuleSet>
    <Span color="Comment">
      <Begin>\#</Begin>
    </Span>

    <Span color="String" multiline="true">
      <Begin>"""</Begin>
      <End>"""</End>
      <RuleSet>
        <Rule color="EscapeSequence">\\.</Rule>
        <Rule color="FormatSpecifier">%[a-zA-Z]</Rule>
      </RuleSet>
    </Span>
    <Span color="String" multiline="true">
      <Begin>'''</Begin>
      <End>'''</End>
      <RuleSet>
        <Rule color="EscapeSequence">\\.</Rule>
        <Rule color="FormatSpecifier">%[a-zA-Z]</Rule>
      </RuleSet>
    </Span>
    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Rule color="EscapeSequence">\\.</Rule>
        <Rule color="FormatSpecifier">%[a-zA-Z]</Rule>
      </RuleSet>
    </Span>
    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Rule color="EscapeSequence">\\.</Rule>
        <Rule color="FormatSpecifier">%[a-zA-Z]</Rule>
      </RuleSet>
    </Span>

    <Span color="Decorator">
      <Begin>@</Begin>
      <End>\s</End>
    </Span>

    <Keywords color="DeclarationKeyword">
      <Word>def</Word>
    </Keywords>

    <Keywords color="Keyword">
      <Word>and</Word>
      <Word>as</Word>
      <Word>assert</Word>
      <Word>async</Word>
      <Word>await</Word>
      <Word>break</Word>
      <Word>class</Word>
      <Word>continue</Word>
      <Word>del</Word>
      <Word>elif</Word>
      <Word>else</Word>
      <Word>except</Word>
      <Word>finally</Word>
      <Word>for</Word>
      <Word>from</Word>
      <Word>global</Word>
      <Word>if</Word>
      <Word>import</Word>
      <Word>in</Word>
      <Word>is</Word>
      <Word>lambda</Word>
      <Word>nonlocal</Word>
      <Word>not</Word>
      <Word>or</Word>
      <Word>pass</Word>
      <Word>raise</Word>
      <Word>return</Word>
      <Word>try</Word>
      <Word>while</Word>
      <Word>with</Word>
      <Word>yield</Word>
    </Keywords>

    <Keywords color="Constant">
      <Word>True</Word>
      <Word>False</Word>
      <Word>None</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>bool</Word>
      <Word>bytes</Word>
      <Word>complex</Word>
      <Word>dict</Word>
      <Word>float</Word>
      <Word>frozenset</Word>
      <Word>int</Word>
      <Word>list</Word>
      <Word>object</Word>
      <Word>set</Word>
      <Word>str</Word>
      <Word>tuple</Word>
    </Keywords>

    <Keywords color="BuiltinFunction">
      <Word>print</Word>
      <Word>range</Word>
      <Word>len</Word>
      <Word>type</Word>
      <Word>input</Word>
      <Word>open</Word>
      <Word>super</Word>
      <Word>isinstance</Word>
      <Word>enumerate</Word>
      <Word>zip</Word>
      <Word>map</Word>
      <Word>filter</Word>
      <Word>sorted</Word>
      <Word>reversed</Word>
      <Word>abs</Word>
      <Word>min</Word>
      <Word>max</Word>
      <Word>sum</Word>
      <Word>any</Word>
      <Word>all</Word>
      <Word>hasattr</Word>
      <Word>getattr</Word>
      <Word>setattr</Word>
    </Keywords>

    <Keywords color="Self">
      <Word>self</Word>
      <Word>cls</Word>
    </Keywords>

    <Rule color="FunctionCall">
      \b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()
    </Rule>

    <Rule color="Number">
      \b0[xX][0-9a-fA-F]+\b|\b0[oO][0-7]+\b|\b0[bB][01]+\b|\b[0-9]+\.?[0-9]*([eE][+-]?[0-9]+)?\b
    </Rule>
  </RuleSet>
</SyntaxDefinition>
